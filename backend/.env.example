APP_NAME=Team Task Manager API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ethara
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated extra origins, e.g. https://your-preview.vercel.app
CORS_ALLOWED_ORIGINS=
# Optional: regex for dynamic preview domains, e.g. ^https://.*\\.vercel\\.app$
CORS_ALLOW_ORIGIN_REGEX=
JWT_SECRET_KEY=change-me-access-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
